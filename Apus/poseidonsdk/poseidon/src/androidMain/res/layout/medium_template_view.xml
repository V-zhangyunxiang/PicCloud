<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <com.poseidon.ad.main.adinfo.custom.NativeAdView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_ffffffff"
            android:padding="5dp">

            <com.poseidon.ad.main.adinfo.custom.MediaView
                android:id="@+id/media"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:background="#FF0000"
                tools:layout_height="100dp" />

            <com.poseidon.ad.main.adinfo.custom.AdIconView
                android:id="@+id/ad_icon"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_below="@id/media"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                tools:background="#00FF00" />

            <Button
                android:id="@+id/cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/ad_icon"
                android:layout_alignBottom="@id/ad_icon"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_primary_radius16"
                android:gravity="center"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:textColor="@color/color_ffffffff"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                tools:text="CTA" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/ad_icon"
                android:layout_toStartOf="@id/cta"
                android:layout_toEndOf="@id/ad_icon"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_000000"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="ad title" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/ad_icon"
                android:layout_toStartOf="@id/cta"
                android:layout_toEndOf="@id/ad_icon"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_777777"
                android:textSize="13sp"
                tools:text="ad description" />

            <com.poseidon.ad.main.adinfo.custom.AdLogoView
                android:id="@+id/ad_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/ad_icon"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:visibility="gone"
                tools:background="#904F00"
                tools:layout_height="20dp"
                tools:layout_width="2dp"
                tools:visibility="visible" />
        </RelativeLayout>
    </com.poseidon.ad.main.adinfo.custom.NativeAdView>
</merge>
